# Crie um projeto no Supabase e preencha os dados em um arquivo .env local.
# Nunca coloque a service_role key no aplicativo; use somente a anon/public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço público do aplicativo, usado no link de recuperação de senha.
# Por que existe: dentro do aplicativo instalado o endereço é `http://localhost`,
# que não abre em nada no navegador do telefone. No navegador, sem esta
# variável, o app usa o próprio endereço de onde está rodando. Sem ela e fora
# do navegador, a tela de recuperação avisa que falta configurar em vez de
# mandar um e-mail que não leva a lugar nenhum.
VITE_APP_URL=
